                    <button id="btnXkonglong" imageMso="GroupInsertLinks" onAction="btnXkonglong_Click" screentip="访问作者网站" supertip="http://xkonglong.com" label="访问网站" />
                    <button id="btnHelp" imageMso="Help" onAction="btnHelp_Click" label="在线帮助" />
