                    <dynamicMenu id="mnuTitle4" imageMso="_4" keytip="4" screentip="选中文字时,设置标题序号和字体格式;  未选中文字时,只设置标题序号,不设置字体格式." label="标题(1)" getContent="mnuTitle4_GetContent" />
